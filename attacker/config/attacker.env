TRAFFIC_SPREADER__TARGET_BASE_URL=http://host.docker.internal:8080
TRAFFIC_SPREADER__REQUEST_TIMEOUT_SECONDS=60
TRAFFIC_SPREADER__SOURCE_IP_MODE=simulated_header
TRAFFIC_SPREADER__SIMULATED_IP_HEADER=X-Simulated-Source-IP
TRAFFIC_SPREADER__SIMULATED_SOURCE_IPS=10.10.0.1,10.10.0.2,10.10.0.3,10.10.0.4
TRAFFIC_SPREADER__SIMULATED_SOURCE_IP_WEIGHTS={"10.10.0.1":90,"10.10.0.2":4,"10.10.0.3":3,"10.10.0.4":3}
TRAFFIC_SPREADER__REAL_SOURCE_IPS=
TRAFFIC_SPREADER__REAL_SOURCE_IP_WEIGHTS={}

OBSERVER__ENABLED=true
OBSERVER__TARGET_URL=http://host.docker.internal:8080/quick_response
OBSERVER__INTERVAL_SECONDS=1
OBSERVER__TIMEOUT_SECONDS=2
